map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  # Resolve the API at request time: the API is redeployed independently and its private IP changes.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;
  # Authenticated login responses carry several cookies; the default 4k/8k header buffers return 502.
  large_client_header_buffers 4 32k;
  auth_basic ${DEMO_GATE_AUTH_BASIC};
  auth_basic_user_file /etc/nginx/demo.htpasswd;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  add_header X-Content-Type-Options nosniff always;
  location = /healthz { auth_basic off; access_log off; return 200 'ok'; }
  location = /robots.txt { return 200 "User-agent: *\nDisallow:\n"; }
  location ~* \.map$ { return 404; }
  # Every browser API/TUS/SCORM request uses the same public origin.
  location /api/ {
    set $api_upstream http://${API_PRIVATE_HOST}:${API_PRIVATE_PORT};
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Never forward the gate credentials to the API.
    proxy_set_header Authorization "";
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    client_max_body_size 110m;
    proxy_read_timeout 300s;
    add_header Cache-Control "private, no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  }
  location /socket.io/ {
    set $api_upstream http://${API_PRIVATE_HOST}:${API_PRIVATE_PORT};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin https://$host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
  }
  location / { add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    try_files $uri $uri/ /index.html; }
}
