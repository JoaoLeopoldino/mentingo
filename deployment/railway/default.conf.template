map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  auth_basic "Utu Lab - Demonstracao restrita";
  auth_basic_user_file /etc/nginx/demo.htpasswd;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  add_header X-Content-Type-Options nosniff always;
  location = /healthz { auth_basic off; access_log off; return 200 'ok'; }
  location = /robots.txt { return 200 "User-agent: *\nDisallow:\n"; }
  location ~* \.map$ { return 404; }
  # Every browser API/TUS/SCORM request uses the same public origin.
  location /api/ {
    proxy_pass http://${API_PRIVATE_HOST}:${API_PRIVATE_PORT};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    client_max_body_size 110m;
    proxy_read_timeout 300s;
    add_header Cache-Control "private, no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  }
  location /socket.io/ {
    proxy_pass http://${API_PRIVATE_HOST}:${API_PRIVATE_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin https://$host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
  }
  location / { add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    try_files $uri $uri/ /index.html; }
}
